# ========================================
# 환경변수 설정 예시
# ========================================
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요.
# 개발 모드에서는 이 파일 없이도 기본값으로 실행됩니다.

# ========================================
# 서버 설정
# ========================================
PORT=3002
NODE_ENV=development

# ========================================
# 인증 설정 (프로덕션에서 필수)
# ========================================
# JWT 토큰 서명에 사용되는 비밀키 (32자 이상 권장)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 관리자 페이지 비밀번호
ADMIN_PASSWORD=your-admin-password

# ========================================
# Cloudflare R2 스토리지 (프로덕션에서 필수)
# ========================================
# R2 엔드포인트 URL
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# R2 버킷 이름
R2_BUCKET=your-bucket-name

# R2 액세스 키 ID
R2_ACCESS_KEY_ID=your-access-key-id

# R2 시크릿 액세스 키
R2_SECRET_ACCESS_KEY=your-secret-access-key

# ========================================
# 기타 설정 (선택사항)
# ========================================
# CORS 허용 도메인 (쉼표로 구분)
CORS_ORIGIN=http://localhost:3002,https://yourdomain.com

# 업로드 디렉토리
UPLOAD_DIR=uploads

# 최대 파일 크기 (바이트)
MAX_FILE_SIZE=52428800

# 변환 시뮬레이션 지연 시간 (밀리초)
CONVERSION_DELAY=2000

# Google AdSense Publisher ID
ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx

# 데이터베이스 경로
DB_PATH=config/app.db
